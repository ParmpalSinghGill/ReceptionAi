# Base URL of apps/api. Matches docker-compose's published API_PORT.
# The demo chat mints its session and opens its SSE stream against this host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of apps/media, the realtime voice worker (MEDIA_PORT in the root
# .env). A separate origin from the API because voice runs in its own process:
# a slow model call in an HTTP handler would head-of-line block audio frames
# (Core Contract A1). "Request a call" POSTs its WebRTC offer here.
NEXT_PUBLIC_MEDIA_URL=http://localhost:8100
