# This repository lives on an NTFS volume (ntfs3). pnpm's default linker
# hardlinks from a global store into node_modules; NTFS-via-ntfs3 does not
# support that reliably, and pnpm's fallback path exhausts the Node heap on a
# dependency graph this size (reproduced: OOM at 8GB in-repo, clean install of
# the identical package set on ext4).
#
# `node-linker=hoisted` writes a plain, npm-style node_modules by copying, which
# NTFS handles fine. `package-import-method=copy` makes the copy explicit rather
# than letting pnpm probe for hardlink support on every file.
node-linker=hoisted
package-import-method=copy
